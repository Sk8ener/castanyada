<%- include('./templates/head', { title: title }) %>
<body>
  <!-- Header con menú -->
  <%- include('./templates/header', { lang: "CAT", menu: menu }) %>

  <main>
    <h1>Lista de productos</h1>
    <ul>
      <% sweets.forEach(sweet => { %>
        <li>
          <strong><%= sweet.name_cat %></strong> - <%= sweet.preu %> €
          <br>
          <em><%= sweet.descripcio_cat %></em>
          <% if (sweet.img) { %>
            <br>
            <img src="/img/<%= sweet.img %>" alt="<%= sweet.name_cat %>" width="200">
          <% } %>
        </li>
      <% }) %>
    </ul>
  </main>
</body>
</html>
